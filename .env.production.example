# Safe production template. Copy to the VPS as .env and replace every placeholder.
# Never commit the completed .env. Generate secrets with the commands in docs/VPS_DEPLOYMENT.md.

# APP
NODE_ENV=production
APP_URL=https://ai.growthifyx.space
DEV_PREVIEW=false
LOG_LEVEL=info
TZ=Asia/Dhaka

# DATABASE
POSTGRES_USER=growthifyx
POSTGRES_DB=growthifyx
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://growthifyx:URL_ENCODED_PASSWORD@postgres:5432/growthifyx?schema=public

# AUTH
ADMIN_EMAIL=
SESSION_SECRET=

# ENCRYPTION
APP_ENCRYPTION_KEY=

# META (optional bootstrap fallback; preferred production configuration is Settings > Meta Platform)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_REDIRECT_URI=https://ai.growthifyx.space/api/meta/oauth/callback
META_WEBHOOK_URL=https://ai.growthifyx.space/api/meta/webhook
META_GRAPH_VERSION=v23.0
META_LOGIN_CONFIG_ID=

# CADDY
CADDY_DOMAIN=ai.growthifyx.space

# The Compose file intentionally publishes only Caddy's 80/443 listeners.
# Do not add a POSTGRES_PORT or APP_PORT mapping.

# DeepSeek and Telegram are intentionally absent here. Configure them per Page in the Admin UI.
