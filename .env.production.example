# Safe production template. Copy to the VPS as .env and replace every blank or placeholder value.

# APP
NODE_ENV=production
APP_URL=https://ai.growthifyx.space
DEV_PREVIEW=false

# DATABASE
DATABASE_URL=

# AUTH
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# ENCRYPTION
APP_ENCRYPTION_KEY=

# META
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_REDIRECT_URI=https://ai.growthifyx.space/api/meta/oauth/callback
META_WEBHOOK_URL=https://ai.growthifyx.space/api/meta/webhook
META_GRAPH_VERSION=v23.0

# DEEPSEEK
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_INPUT_RATE=0
DEEPSEEK_OUTPUT_RATE=0

# TELEGRAM (only needed when Telegram delivery is enabled)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
