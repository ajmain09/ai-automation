generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConfigStatus {
  DRAFT
  LIVE
  ARCHIVED
}

enum ConnectionStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum IssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  EXPIRED
}

enum OutboundStatus {
  PENDING
  SENDING
  SENT
  UNKNOWN_DELIVERY
  FAILED_RETRYABLE
  FAILED_PERMANENT
}

enum AiCallType {
  CHAT_REPLY
  BUSINESS_PARSE
  MEMORY_SUMMARY
  PRELIVE_TEST
  RETRY
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED_RETRYABLE
  FAILED_PERMANENT
  DEAD_LETTER
}

enum MemoryFactStatus {
  ACTIVE
  SUPERSEDED
  REJECTED
  UNCONFIRMED
}

enum BudgetReservationStatus {
  RESERVED
  SETTLED
  RELEASED
  EXPIRED
}

model Admin {
  id             String               @id @default(uuid()) @db.Uuid
  email          String               @unique
  passwordHash   String
  name           String?
  lastLoginAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  auditLogs      AuditLog[]
  recoveryTokens AdminRecoveryToken[]
}

model AdminRecoveryToken {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
}

model Page {
  id                    String                 @id @default(uuid()) @db.Uuid
  metaPageId            String?                @unique
  name                  String
  slug                  String                 @unique
  isActive              Boolean                @default(true)
  aiEnabled             Boolean                @default(false)
  aiStatus              String                 @default("PAUSED")
  connectionStatus      ConnectionStatus       @default(DISCONNECTED)
  lifecycleStatus       String                 @default("DRAFT")
  readinessCheckedAt    DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  connection            PageConnection?
  settings              PageSettings?
  configurationVersions ConfigurationVersion[]
  businessProfile       BusinessProfile?
  knowledgeItems        KnowledgeItem[]
  products              Product[]
  customers             Customer[]
  memoryFacts           CustomerMemoryFact[]
  conversations         Conversation[]
  messages              Message[]
  webhookEvents         WebhookEvent[]
  orderSessions         OrderSession[]
  orders                Order[]
  jobs                  Job[]
  outboundMessages      OutboundMessage[]
  deliveryOutbox        DeliveryOutbox[]
  aiRuns                AiRun[]
  apiUsage              ApiUsage[]
  issues                Issue[]
  auditLogs             AuditLog[]
  dataDeletionRequests  DataDeletionRequest[]
  aiSettings            PageAiSettings?
  telegramSettings      PageTelegramSettings?
  costSettings          PageCostSettings?
  budgetReservations    AiBudgetReservation[]
}

model PageConnection {
  id                    String           @id @default(uuid()) @db.Uuid
  pageId                String           @unique @db.Uuid
  status                ConnectionStatus @default(DISCONNECTED)
  provider              String           @default("meta")
  encryptedToken        String?
  connectedAt           DateTime?
  lastError             String?
  subscribedAt          DateTime?
  lastHealthCheckAt     DateTime?
  lastHealthCheckStatus String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  page                  Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model PageSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  pageId              String   @unique @db.Uuid
  currency            String   @default("USD")
  countryCode         String   @default("US")
  defaultLanguage     String   @default("en")
  tone                String   @default("helpful")
  requiredOrderFields Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  page                Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model PageAiSettings {
  id                        String    @id @default(uuid()) @db.Uuid
  pageId                    String    @unique @db.Uuid
  language                  String    @default("auto")
  tone                      String    @default("natural_sales")
  replyLength               String    @default("short")
  provider                  String    @default("deepseek")
  encryptedApiKey           String?
  baseUrl                   String    @default("https://api.deepseek.com")
  model                     String    @default("deepseek-v4-flash")
  thinkingOverride          String?
  maxOutputTokens           Int?
  understandBeforeRecommend Boolean   @default(true)
  suggestCombo              Boolean   @default(true)
  askOneQuestionAtATime     Boolean   @default(true)
  mirrorCustomerLanguage    Boolean   @default(true)
  customerMemory            Boolean   @default(true)
  recentMessageContext      Int       @default(12)
  rollingSummary            Boolean   @default(true)
  smartBuffer               Boolean   @default(true)
  bufferWindowSeconds       Int       @default(8)
  manualCollisionProtection Boolean   @default(true)
  manualActivityCooldown    Int       @default(30)
  customSalesInstructions   String?
  status                    String    @default("NOT_CONFIGURED")
  providerBalanceUsd        Decimal?  @db.Decimal(14, 8)
  providerBalanceCny        Decimal?  @db.Decimal(14, 8)
  providerBalancePayload    Json?
  lastBalanceCheckAt        DateTime?
  lastSuccessfulCallAt      DateTime?
  lastFailedCallAt          DateTime?
  lastError                 String?
  updatedAt                 DateTime  @updatedAt
  createdAt                 DateTime  @default(now())
  page                      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model PageTelegramSettings {
  id                    String    @id @default(uuid()) @db.Uuid
  pageId                String    @unique @db.Uuid
  encryptedBotToken     String?
  chatId                String?
  newOrderEnabled       Boolean   @default(true)
  updatedOrderEnabled   Boolean   @default(true)
  cancelledOrderEnabled Boolean   @default(true)
  status                String    @default("NOT_CONFIGURED")
  lastError             String?
  lastTestAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  page                  Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model PageCostSettings {
  id               String                 @id @default(uuid()) @db.Uuid
  pageId           String                 @unique @db.Uuid
  usdBdtRate       Decimal                @default(120) @db.Decimal(14, 6)
  monthlyBudgetBdt Decimal?               @db.Decimal(14, 2)
  dailyBudgetBdt   Decimal?               @db.Decimal(14, 2)
  hardLimit        Boolean                @default(false)
  warningThreshold Int                    @default(85)
  pausedByBudget   Boolean                @default(false)
  reservedBdt      Decimal                @default(0) @db.Decimal(14, 6)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  page             Page                   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pricingProfiles  PageAiPricingProfile[]
}

model AiBudgetReservation {
  id             String                  @id @default(uuid()) @db.Uuid
  pageId         String                  @db.Uuid
  reservationKey String                  @unique
  aiAttemptId    String?                 @unique
  estimatedBdt   Decimal                 @db.Decimal(14, 6)
  settledBdt     Decimal?                @db.Decimal(14, 6)
  status         BudgetReservationStatus @default(RESERVED)
  expiresAt      DateTime
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  page           Page                    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, status, expiresAt])
}

model ConfigurationVersion {
  id              String       @id @default(uuid()) @db.Uuid
  pageId          String       @db.Uuid
  version         Int
  status          ConfigStatus @default(DRAFT)
  label           String?
  rawBusinessInfo String?
  businessData    Json?
  conflicts       Json?
  parseStatus     String?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  page            Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId, status])
}

model BusinessProfile {
  id                String   @id @default(uuid()) @db.Uuid
  pageId            String   @unique @db.Uuid
  businessName      String?
  description       String?
  benefits          Json?
  deliveryPolicy    String?
  codPolicy         String?
  faq               Json?
  policies          Json?
  salesInstructions String?
  orderRequirements Json?
  notes             String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
  page              Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model KnowledgeItem {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @db.Uuid
  title     String
  content   String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  pageId      String           @db.Uuid
  name        String
  slug        String
  description String?
  benefits    Json?
  tags        Json?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  page        Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]

  @@unique([pageId, slug])
  @@index([pageId, active])
}

model ProductVariant {
  id           String      @id @default(uuid()) @db.Uuid
  productId    String      @db.Uuid
  sku          String
  size         String?
  color        String?
  currentPrice Decimal     @db.Decimal(12, 2)
  oldPrice     Decimal?    @db.Decimal(12, 2)
  stockStatus  StockStatus @default(IN_STOCK)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@index([productId, active])
}

model Customer {
  id            String               @id @default(uuid()) @db.Uuid
  pageId        String               @db.Uuid
  facebookPsid  String
  name          String?
  phone         String?
  phoneOriginal String?
  address       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  page          Page                 @relation(fields: [pageId], references: [id], onDelete: Cascade)
  memory        CustomerMemory?
  memoryFacts   CustomerMemoryFact[]
  conversations Conversation[]
  orders        Order[]

  @@unique([pageId, facebookPsid])
  @@index([pageId])
}

model CustomerMemory {
  id                   String               @id @default(uuid()) @db.Uuid
  customerId           String               @unique @db.Uuid
  memory               Json
  version              Int                  @default(0)
  summaryVersion       Int                  @default(0)
  summaryLastMessageId String?              @db.Uuid
  summaryGeneratedAt   DateTime?
  summaryStale         Boolean              @default(false)
  updatedAt            DateTime             @updatedAt
  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  facts                CustomerMemoryFact[]

  @@index([customerId, version])
}

model CustomerMemoryFact {
  id                 String               @id @default(uuid()) @db.Uuid
  pageId             String               @db.Uuid
  customerId         String               @db.Uuid
  factKey            String
  normalizedValue    Json
  displayValue       String?
  sourceMessageId    String?              @db.Uuid
  sourceType         String               @default("AI_EXTRACTION")
  confidence         Decimal?             @db.Decimal(5, 4)
  status             MemoryFactStatus     @default(ACTIVE)
  firstSeenAt        DateTime             @default(now())
  lastConfirmedAt    DateTime?
  updatedAt          DateTime             @updatedAt
  supersededByFactId String?              @db.Uuid
  expiresAt          DateTime?
  page               Page                 @relation(fields: [pageId], references: [id], onDelete: Cascade)
  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceMessage      Message?             @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  supersededBy       CustomerMemoryFact?  @relation("MemoryFactSupersession", fields: [supersededByFactId], references: [id], onDelete: SetNull)
  supersedes         CustomerMemoryFact[] @relation("MemoryFactSupersession")
  customerMemory     CustomerMemory?      @relation(fields: [customerMemoryId], references: [id])
  customerMemoryId   String?              @db.Uuid

  @@unique([customerId, sourceMessageId, factKey])
  @@index([pageId, customerId, factKey, status])
  @@index([pageId, customerId, updatedAt])
}

model Conversation {
  id                    String            @id @default(uuid()) @db.Uuid
  pageId                String            @db.Uuid
  customerId            String?           @db.Uuid
  providerId            String?
  version               Int               @default(0)
  lastCustomerMessageAt DateTime?
  bufferUntil           DateTime?
  manualReplyUntil      DateTime?
  lastManualReplyAt     DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  page                  Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  customer              Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages              Message[]
  jobs                  Job[]
  outboundMessages      OutboundMessage[]

  @@unique([pageId, providerId])
  @@index([pageId])
}

model OAuthState {
  id                 String    @id @default(uuid()) @db.Uuid
  stateHash          String    @unique
  redirectUri        String
  encryptedUserToken String?
  permissionDiagnostics Json?
  callbackCompletedAt DateTime?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  consumedAt         DateTime?
}

model Message {
  id             String               @id @default(uuid()) @db.Uuid
  pageId         String               @db.Uuid
  conversationId String               @db.Uuid
  providerId     String
  direction      MessageDirection
  text           String?
  senderPsid     String?
  isEcho         Boolean              @default(false)
  metadata       Json?
  createdAt      DateTime             @default(now())
  page           Page                 @relation(fields: [pageId], references: [id], onDelete: Cascade)
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  memoryFacts    CustomerMemoryFact[]

  @@unique([pageId, providerId])
  @@index([pageId, createdAt])
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  pageId         String?   @db.Uuid
  providerId     String    @unique
  payload        Json
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  eventType      String?
  ignoredReason  String?
  signatureValid Boolean   @default(false)
  page           Page?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
}

model OrderSession {
  id         String   @id @default(uuid()) @db.Uuid
  pageId     String   @db.Uuid
  customerId String?  @db.Uuid
  state      Json
  status     String   @default("ACTIVE")
  orderId    String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, customerId, status])
}

model Order {
  id                   String          @id @default(uuid()) @db.Uuid
  pageId               String          @db.Uuid
  customerId           String?         @db.Uuid
  orderSessionId       String          @db.Uuid
  status               String          @default("BROWSING")
  total                Decimal?        @db.Decimal(12, 2)
  payload              Json
  productId            String?         @db.Uuid
  productName          String?
  variantId            String?         @db.Uuid
  variantDetails       Json?
  unitPrice            Decimal?        @db.Decimal(12, 2)
  quantity             Int?
  currency             String?
  customerName         String?
  normalizedPhone      String?
  phoneOriginal        String?
  fullAddress          String?
  configurationVersion Int?
  confirmedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  page                 Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  customer             Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  revisions            OrderRevision[]
}

model OrderRevision {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @db.Uuid
  revision      Int
  payload       Json
  eventType     String   @default("UPDATED")
  changedFields Json?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, revision])
}

model Job {
  id             String        @id @default(uuid()) @db.Uuid
  pageId         String?       @db.Uuid
  type           String
  status         JobStatus     @default(PENDING)
  payload        Json?
  attempts       Int           @default(0)
  runAt          DateTime      @default(now())
  conversationId String?       @db.Uuid
  idempotencyKey String?       @unique
  leaseUntil     DateTime?
  maxAttempts    Int           @default(5)
  expiresAt      DateTime?
  lastError      String?
  lockedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  page           Page?         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([conversationId, status, runAt])
  @@index([expiresAt, status])
}

model OutboundMessage {
  id                 String         @id @default(uuid()) @db.Uuid
  pageId             String         @db.Uuid
  outboundAttemptKey String         @unique
  providerMessageId  String?
  payload            Json
  conversationId     String?        @db.Uuid
  status             OutboundStatus @default(PENDING)
  lastError          String?
  sentAt             DateTime?
  updatedAt          DateTime       @updatedAt
  createdAt          DateTime       @default(now())
  page               Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  conversation       Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([pageId, status, createdAt])
}

model DeliveryOutbox {
  id               String            @id @default(uuid()) @db.Uuid
  pageId           String            @db.Uuid
  deliveryKey      String            @unique
  payload          Json
  eventType        String
  revision         Int
  status           DeliveryStatus    @default(PENDING)
  attempts         Int               @default(0)
  maxAttempts      Int               @default(8)
  nextAttemptAt    DateTime          @default(now())
  leaseUntil       DateTime?
  lastError        String?
  sentAt           DateTime?
  createdAt        DateTime          @default(now())
  page             Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  deliveryAttempts DeliveryAttempt[]
}

model DeliveryAttempt {
  id               String         @id @default(uuid()) @db.Uuid
  deliveryOutboxId String         @db.Uuid
  success          Boolean
  response         Json?
  attemptedAt      DateTime       @default(now())
  deliveryOutbox   DeliveryOutbox @relation(fields: [deliveryOutboxId], references: [id], onDelete: Cascade)
}

model AiRun {
  id                String     @id @default(uuid()) @db.Uuid
  pageId            String     @db.Uuid
  attemptId         String
  provider          String
  model             String?
  status            String
  inputTokens       Int?
  outputTokens      Int?
  callType          AiCallType
  providerRequestId String?
  attemptNumber     Int        @default(1)
  totalTokens       Int?
  cachedInputTokens Int?
  providerUsageJson Json?
  latencyMs         Int?
  errorCode         String?
  createdAt         DateTime   @default(now())
  page              Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  apiUsage          ApiUsage?

  @@unique([pageId, attemptId])
}

model ApiUsage {
  id                    String                @id @default(uuid()) @db.Uuid
  pageId                String                @db.Uuid
  aiAttemptId           String                @unique @db.Uuid
  provider              String
  model                 String?
  callType              AiCallType
  inputTokens           Int                   @default(0)
  cachedInputTokens     Int?
  outputTokens          Int                   @default(0)
  totalTokens           Int                   @default(0)
  providerUsageJson     Json?
  inputRateSnapshot     Decimal?              @db.Decimal(12, 8)
  inputHitRateSnapshot  Decimal?              @db.Decimal(12, 8)
  inputMissRateSnapshot Decimal?              @db.Decimal(12, 8)
  outputRateSnapshot    Decimal?              @db.Decimal(12, 8)
  usdBdtRateSnapshot    Decimal?              @db.Decimal(12, 8)
  providerRequestId     String?
  attemptNumber         Int                   @default(1)
  status                String                @default("SUCCEEDED")
  latencyMs             Int?
  estimatedCost         Decimal?              @db.Decimal(12, 6)
  estimatedCostUsd      Decimal?              @db.Decimal(14, 8)
  estimatedCostBdt      Decimal?              @db.Decimal(14, 6)
  costEstimated         Boolean               @default(true)
  pricingProfileId      String?               @db.Uuid
  createdAt             DateTime              @default(now())
  page                  Page                  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  aiRun                 AiRun                 @relation(fields: [aiAttemptId], references: [id], onDelete: Cascade)
  pricingProfile        PageAiPricingProfile? @relation(fields: [pricingProfileId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
}

model MetaPlatformSetting {
  id                   String    @id @default(uuid()) @db.Uuid
  appId                String?
  appSecretEncrypted   String?
  verifyTokenEncrypted String?
  graphApiVersion      String    @default("v23.0")
  loginConfigurationId  String?
  oauthRedirectUri     String?
  webhookUrl           String?
  status               String    @default("NOT_CONFIGURED")
  lastApiTestAt        DateTime?
  lastError            String?
  updatedAt            DateTime  @updatedAt
  createdAt            DateTime  @default(now())
}

model PageAiPricingProfile {
  id                          String           @id @default(uuid()) @db.Uuid
  pageId                      String           @db.Uuid
  model                       String
  effectiveFrom               DateTime
  inputCacheHitPerMillionUsd  Decimal          @db.Decimal(14, 8)
  inputCacheMissPerMillionUsd Decimal          @db.Decimal(14, 8)
  outputPerMillionUsd         Decimal          @db.Decimal(14, 8)
  peakMultiplier              Decimal?         @db.Decimal(8, 4)
  peakScheduleEnabled         Boolean          @default(false)
  createdAt                   DateTime         @default(now())
  usages                      ApiUsage[]
  pageCostSettings            PageCostSettings @relation(fields: [pageId], references: [pageId], onDelete: Cascade)

  @@unique([pageId, model])
  @@index([pageId, model, effectiveFrom])
}

model Issue {
  id               String      @id @default(uuid()) @db.Uuid
  pageId           String?     @db.Uuid
  type             String      @default("GENERAL")
  status           IssueStatus @default(OPEN)
  severity         String      @default("medium")
  title            String
  description      String?
  resolutionAction String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  page             Page?       @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([pageId, status])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String?  @db.Uuid
  pageId    String?  @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
}

model DataDeletionRequest {
  id              String    @id @default(uuid()) @db.Uuid
  requestKey      String    @unique
  pageId          String    @db.Uuid
  customerId      String    @db.Uuid
  status          String    @default("COMPLETED")
  ordersPreserved Int       @default(0)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  page            Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
