# APP
APP_URL="http://localhost:3000"
NODE_ENV="development"

# DATABASE (PostgreSQL only)
DATABASE_URL="postgresql://growthifyx:change-me@localhost:5432/growthifyx?schema=public"

# AUTH
SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_EMAIL="admin@example.com"
# Set an explicit local password; never use a default in production.
ADMIN_PASSWORD="replace-with-a-long-local-only-password"

# ENCRYPTION
# Credentials use the encryption service boundary derived from SESSION_SECRET.

# META
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/meta/oauth/callback"
META_GRAPH_VERSION="v23.0"
META_VERIFY_TOKEN="replace-with-a-random-webhook-verify-token"

# DEEPSEEK
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_INPUT_RATE="0"
DEEPSEEK_OUTPUT_RATE="0"

# TELEGRAM
# Runtime destinations are stored encrypted in PostgreSQL; these are optional bootstrap placeholders.
TELEGRAM_DEFAULT_BOT_TOKEN=""
TELEGRAM_DEFAULT_CHAT_ID=""

# CADDY / DOMAIN
CADDY_DOMAIN="localhost"
