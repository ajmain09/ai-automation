# Local development template. Copy to .env.local and keep that file uncommitted.

# APP
APP_URL="http://localhost:3000"
NODE_ENV="development"
DEV_PREVIEW="true"

# DATABASE-FREE LOCAL PREVIEW AUTH
PREVIEW_ADMIN_EMAIL="admin@local.test"
PREVIEW_ADMIN_PASSWORD="Admin123!"
SESSION_SECRET="replace-with-at-least-32-random-local-characters"

# NORMAL DEVELOPMENT / PRODUCTION DATABASE
DATABASE_URL="postgresql://growthifyx:change-me@localhost:5432/growthifyx?schema=public"

# AUTH (not needed for database-free preview)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-local-only-password"

# ENCRYPTION (required outside database-free preview)
APP_ENCRYPTION_KEY="replace-with-at-least-32-random-encryption-characters"

# META (not needed for database-free preview)
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
META_REDIRECT_URI="http://localhost:3000/api/meta/oauth/callback"
META_WEBHOOK_URL="http://localhost:3000/api/meta/webhook"
META_GRAPH_VERSION="v23.0"
META_LOGIN_CONFIG_ID=""

# DEEPSEEK (optional for local preview; Test AI reports when absent)

# TELEGRAM (configured through the encrypted settings boundary in production)
